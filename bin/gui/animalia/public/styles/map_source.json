{
  "version": 8,

  "name": "Animalia",

  "center": [0, 20],

  "zoom": 1.4,

  "projection": {
    "type": "globe"
  },

  "sources": {
    "satellite": {
      "type": "raster",
      "tiles": ["https://tile.gbif.org/3857/satellite/{z}/{x}/{y}.jpg"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "© GBIF"
    },

    "animal-range": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },

  "layers": [
    {
      "id": "satellite",
      "type": "raster",
      "source": "satellite"
    },

    {
      "id": "animal-range-fill",
      "type": "fill",
      "source": "animal-range",

      "paint": {
        "fill-color": ["coalesce", ["get", "fill_color"], "#FFAA00"],

        "fill-opacity": ["coalesce", ["get", "fill_opacity"], 0.35]
      }
    },
    {
      "id": "animal-range-points",
      "type": "circle",
      "source": "animal-range",
      "paint": {
        "circle-radius": 4,
        "circle-color": ["coalesce", ["get", "fill_color"], "#FFAA00"],
        "circle-opacity": 0.7,
        "circle-stroke-width": 1,
        "circle-stroke-color": ["coalesce", ["get", "outline_color"], "#FFFFFF"]
      }
    },

    {
      "id": "animal-range-outline",
      "type": "line",
      "source": "animal-range",

      "paint": {
        "line-color": ["coalesce", ["get", "outline_color"], "#FFFFFF"],

        "line-width": 2,

        "line-opacity": 0.8
      }
    }
  ]
}
